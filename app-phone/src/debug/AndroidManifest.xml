<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">

        <!-- Spike WC-43 (solo debug): ¿puede una app no-DPC bloquear el S26 Ultra con DevicePolicyManager.lockNow()?
             Todo se abre y se dispara desde adb (el shell tiene DUMP); nada de esto llega al build de release. -->
        <receiver
            android:name=".spike.LockSpikeAdminReceiver"
            android:exported="true"
            android:label="Watch Companion (spike de bloqueo)"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/spike_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".spike.LockSpikeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Bloqueo con la app en segundo plano, como llegaría un comando del reloj. -->
        <receiver
            android:name=".spike.LockSpikeTrigger"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
