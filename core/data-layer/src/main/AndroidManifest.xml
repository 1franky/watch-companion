<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Recibe los mensajes del companion aunque la app esté cerrada. Solo rutas /wc/: la Data Layer ya restringe
          la entrega a apps con el mismo applicationId y firma (WC-ADR-011).
        -->
        <service
            android:name="mx.watchcompanion.core.datalayer.LinkListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/wc/"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
