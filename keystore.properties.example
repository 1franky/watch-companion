# Copia este archivo a keystore.properties (ignorado por Git) para firmar release en local.
# app-watch y app-phone DEBEN firmarse con la misma llave: si no, la Data Layer no los comunica (ADR-011).
# En CI los mismos valores llegan como KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS y KEY_PASSWORD.
storeFile=/ruta/absoluta/watch-companion-release.jks
storePassword=
keyAlias=watch-companion
keyPassword=
